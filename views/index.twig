{% extends 'layout.twig' %}
{% block title %}MIMICRY EXPERIMENTS - Official{% endblock %}

{% block content %}

    <section class="hero">
        <div>
            <div class="eyebrow">SURVIVAL HORROR · PUZZLE · PC</div>
            <h1>MUSIMY <b>STĄD</b> UCIEC.</h1>
            <p>Naukowcy próbują uwolnić się z zamkniętego w innym wymiarze laboratorium. Miejsce jest rezultatem ich błędnego eksperymentu. Jak się stąd wydostać?.</p>
            <div class="actions">
                <a class="btn" href="/gallery">ZOBACZ GRĘ →</a>
                <a class="btn ghost" href="/devlog">DEVLOG</a>
            </div>
        </div>
        <div class="hero-visual">
            <img src="jumpscare.png">
            <div class="scan">MIMICRY / ENTITY 01<br><small>UNKNOWN · HOSTILE</small></div>
        </div>
    </section>
    <section class="section">
        <h2>Każda zagadka przybliża was <br>do <b>wyjścia.</b></h2>
        <div class="cards">
            <article>
                <i>01</i>
                <h3>Eksplorujcie</h3>
                <p>Przeszukujcie tajne laboratorium, kostnicę i pokój badań, odkrywając ślady eksperymentów oraz wskazówki dotyczące Obiektu Zero.</p>
            </article>
            <article>
                <i>02</i>
                <h3>Współpracujcie</h3>
                <p>Każde z was doświadcza rzeczywistości inaczej. Dzielcie się tym, co widzicie, i wspólnie odtwarzajcie prawdziwy obraz spaczonego świata.</p>
            </article>
            <article>
                <i>03</i>
                <h3>Rozwiązujcie</h3>
                <p>Rozwiązujcie przestrzenne zagadki, odbudujcie maszynę stabilizującą i znajdźcie sposób na zamknięcie portalu,
                    zanim surrealistyczny wymiar pochłonie was na zawsze.</p>
            </article>
        </div>
    </section>
    <section class="section dark">
        <div class="split">
            <div>
                <h2>ZESPÓŁ PIEŚNI<br><b>I HAZARDU</b></h2>
                <p>Grupa twórców stojąca za Mimicry Experiments. Łączymy horror, zagadki i narrację środowiskową.</p>
            </div>
            <div class="quote">
                „Obiekt testowy nie może się <b>wydostać.</b>”
            </div>
        </div>
        <div class="cards">
            <article>
                <img src="naukowcy/naukowiec1.png">
                <h3>Bartosz Szajerman</h3>
                <p>Game Developer</p>
            </article>
            <article>
                <img src="naukowcy/naukowiec2.png">
                <h3>Piotr Gutkowski</h3>
                <p>Game Developer, Designer</p>
            </article>
            <article>
                <img src="naukowcy/naukowiec3.png">
                <h3>Jakub Karwalski</h3>
                <p>Game Developer</p>
            </article>
            <article>
                <img src="naukowcy/naukowiec4.png">
                <h3>Mateusz Syska</h3>
                <p>Game Developer</p>
            </article>
            <article>
                <img src="naukowcy/naukowiec5.png">
                <h3>Arkadiusz Owczarek</h3>
                <p>Experience Design</p>
            </article>
            <article>
                <img src="naukowcy/naukowiec6.png">
                <h3>Aleksandra Maliszewska</h3>
                <p>Experience Design</p>
            </article>
        </div>
    </section>

{% endblock %}