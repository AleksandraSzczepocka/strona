{% extends 'layout.twig' %}
{% block title %}MIMICRY EXPERIMENTS - Official{% endblock %}

{% block content %}

    <section class="hero">
        <div>
            <div class="eyebrow">SURVIVAL HORROR · PUZZLE · PC</div>
            <h1>MUSIMY <b>STĄD</b> UCIEC.</h1>
            <p>Naukowcy próbują uwolnić się z zamkniętego w innym wymiarze laboratorium. Miejsce jest rezultatem ich błędnego eksperymentu. Jak się stąd wydostać?.</p>
            <div class="actions">
                <a class="btn" href="/gallery">ZOBACZ GRĘ →</a>
                <a class="btn ghost" href="/devlog">DEVLOG</a>
            </div>
        </div>
        <div class="hero-visual">
            <img src="jumpscare.png">
            <div class="scan">MIMICRY / ENTITY 01<br><small>UNKNOWN · HOSTILE</small></div>
        </div>
    </section>
    <section class="section">
        <h2>Każda zagadka przybliża was <br>do <b>wyjścia.</b></h2>
        <div class="cards">
            <article>
                <i>01</i>
                <h3>Eksplorujcie</h3>
                <p>Przeszukajcie laboratorium, kostnicę oraz pokój badań.</p>
            </article>
            <article>
                <i>02</i>
                <h3>Współpracujcie</h3>
                <p>Każde z was widzi inne wskazówki. Musicie sobie pomagać.</p>
            </article>
            <article>
                <i>03</i>
                <h3>Rozwiązujcie</h3>
                <p>Rozwiążcie zagadki, by odkryć drogę ucieczki.</p>
            </article>
        </div>
    </section>
    <section class="section dark">
        <div class="split">
            <div>
                <h2>ZESPÓŁ PIEŚNI<br><b>I HAZARDU</b></h2>
                <p>Grupa twórców stojąca za Mimicry Experiments. Łączymy horror, zagadki i narrację środowiskową.</p>
            </div>
            <div class="quote">
                „Obiekt testowy nie może się <b>wydostać.</b>”
            </div>
        </div>
    </section>

{% endblock %}