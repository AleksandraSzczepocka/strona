{% extends 'layout.twig' %}
{% block title %}MIMICRY EXPERIMENTS - Logowanie{% endblock %}

{% block body_class %}auth{% endblock %}
{% block header %}{% endblock %}

{% block main_wrapper %}

<a class="logo" href="/">MIMICRY<span> EXPERIMENTS</span></a>
<main class="auth-card">
    <div class="eyebrow">SPOŁECZNOŚĆ</div>
    <h1>UTWÓRZ KONTO</h1>
    <form id="registerForm">
        <input name="username" placeholder="Nazwa użytkownika" required minlength="3">
        <input name="email" type="email" placeholder="E-mail" required>
        <input name="password" type="password" placeholder="Hasło — min. 8 znaków" required minlength="8">
        <label><input type="checkbox" required> Akceptuję regulamin</label>
        <button class="btn">Utwórz konto</button>
    </form>
    <p>Masz już konto? <a href="/login">Zaloguj się</a></p>
    <div id="message"></div>
</main>

{% endblock %}