{% extends 'layout.twig' %}
{% block title %}MIMICRY EXPERIMENTS - Admin{% endblock %}

{% block header %}

<header>
    <a class="logo" href="/">MIMICRY<span> EXPERIMENTS</span></a>
    <nav><a href="/">Witryna</a><a class="active" href="/admin">Panel admina</a></nav>
    <div class="actions">
        <span class="badge">ADMIN</span>
        <a class="btn ghost" href="/profile">Profil</a>
        <button id="logout" class="btn ghost">Wyloguj</button>
    </div>
</header>

{% endblock %}


{% block content %}

<main class="page">
    <div class="eyebrow">ZARZĄDZANIE</div>
    <h1>DASHBOARD</h1>
    <div id="stats" class="stats"></div>
    <div class="admin-panel">
        <h2>DODAJ DEVLOG</h2>
        <form id="postForm">
            <input name="title" placeholder="Tytuł" required>
            <input name="category" placeholder="Kategoria" value="Devlog">
            <textarea name="content" placeholder="Treść" required></textarea>
            <button class="btn">Dodaj</button>
        </form>
    </div>
    <div id="adminMessage"></div>
</main>

{% endblock %}