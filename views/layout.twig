<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="author" content="Aleksandra Maliszewska, Arkadiusz Owczarek, Kacper Patała, Aleksandra Maliszewska" />
    <meta name="keywords" content="gra, horror, ZTGK, puzzle" />
    <meta name="description" content="Strona przedstawiającą grę gatunku puzzle horror zaprezentowaną na konkursie ZTGK" />
    <title>{% block title %}MIMICRY EXPERIMENTS{% endblock %}</title>
    <link rel="icon" href="/uploads/logo.png" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{% block body_class %}{% endblock %}">

    {% block header %}
    <header>
        <a class="logo" href="/">MIMICRY<span> EXPERIMENTS</span></a>
        <nav>
            <a href="/" class="{% if activePage == 'index' %}active{% endif %}">O grze</a>
            <a href="/gallery" class="{% if activePage == 'gallery' %}active{% endif %}">Galeria</a>
            <a href="/devlog" class="{% if activePage == 'devlog' %}active{% endif %}">Devlog</a>
            <a href="/forum" class="{% if activePage == 'forum' %}active{% endif %}">Forum</a>
        </nav>
        <div class="actions" id="authActions"></div>
    </header>
    {% endblock %}

    {% block main_wrapper %}
    <main>
        {% block content %}{% endblock %}
    </main>
    {% endblock %}

    <footer>
        <b>MIMCRY EXPERIMENTS</b>
        <span>ZESPÓŁ PIEŚNI I HAZARDU · 2026</span>
    </footer>
    <script src="/js/app.js"></script>

</body>
</html>