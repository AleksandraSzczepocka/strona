{
  "name": "mimcry-hunters-portal",
  "version": "1.0.0",
  "description": "Full-stack prototype for Mimcry Hunters",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:node": "nodemon -e js,twig server.js",
    "watch:css": "sass --watch styles/main.scss public/css/style.css",
    "build:css": "sass styles/main.scss public/css/style.css && postcss public/css/style.css -o public/css/style.css",
    "dev": "concurrently \"npm run dev:node\" \"npm run watch:css\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "twig": "^3.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "sass": "^1.104.0"
  }
}
